{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "magicoli/bokit-light",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "version": "1.1.0",
    "keywords": [
        "holiday",
        "rental",
        "booking",
        "calendar"
    ],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "andreiio/blade-remix-icon": "*",
        "bezhansalleh/filament-language-switch": "^5.0",
        "blade-ui-kit/blade-icons": "^1.8",
        "codeat3/blade-simple-icons": "^8.1",
        "davidhsianturi/blade-bootstrap-icons": "^2.1",
        "devrabiul/laravel-toaster-magic": "^1.5",
        "faisal50x/blade-ionicons": "^1.1",
        "filament/filament": "^5.0",
        "itsmalikjones/blade-iconic": "^1.3",
        "joaopaulolndev/filament-edit-profile": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "lipis/flag-icons": "^7.5",
        "livewire/livewire": "^4.0",
        "magicoli/extra-navigation-items": "^0.1.0",
        "magicoli/two-way-ticket": "^0.4.2",
        "sabre/vobject": "^4.5",
        "spatie/laravel-backup": "^10.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.8",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.41",
        "magicoli/pest-failure-summary": "^1.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpunit/phpunit": "^11.5.3"
    },
    "repositories": [
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Beds24\\": "modules/beds24/src/",
            "Modules\\Hbook\\": "modules/hbook/src/",
            "Modules\\Multipass\\": "modules/multipass/src/",
            "Modules\\WpConnector\\": "modules/wp-connector/src/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=0.0.0.0\" \"php artisan queue:listen --tries=1\" \"php artisan pail --level=info --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/default.sqlite') || touch('database/default.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
