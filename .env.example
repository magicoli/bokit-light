# Application
APP_NAME=Bokit
APP_SLOGAN="Bring On Kitsch Island Time"
APP_LOGO=🏖️
APP_KEY=
APP_DEBUG=true
APP_ENV=local

# Authentication is now set in options

# Database (auto-configured by default to use SQLite)
DB_CONNECTION=sqlite

# Session & Cache (file-based by default, no config needed)
SESSION_DRIVER=file
CACHE_STORE=file

# debug locally, error or warning in production; rotation keeps LOG_DAILY_DAYS files
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14

# Backups run while the site is used, no system task needed. Intervals in seconds, 0 disables that
# kind: database + settings + key hourly, the uploaded files daily, retention applied daily.
# BACKUP_AUTO=true
# BACKUP_ESSENTIAL_INTERVAL=3600
# BACKUP_FULL_INTERVAL=86400
# BACKUP_CLEANUP_INTERVAL=86400
# BACKUP_DISKS=backups
# BACKUP_PATH=/absolute/path/outside/the/application
# Retention: everything from the last day, then one per day, week, month and year.
# BACKUP_KEEP_ALL_DAYS=1
# BACKUP_KEEP_DAILY_DAYS=7
# BACKUP_KEEP_WEEKLY_WEEKS=4
# BACKUP_KEEP_MONTHLY_MONTHS=12
# Hourly backups are only useful until the next full one covers the same ground.
# BACKUP_KEEP_ESSENTIALS_DAYS=1
# BACKUP_KEEP_YEARLY_YEARS=100
# BACKUP_MAX_MEGABYTES=
# The archive carries .env: set a password if the destination leaves the machine.
# BACKUP_ARCHIVE_PASSWORD=
# BACKUP_NOTIFICATION_EMAIL=
