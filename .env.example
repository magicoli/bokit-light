# Application
APP_NAME=Bokit
APP_SLOGAN="Bring On Kitsch Island Time"
APP_LOGO=🏖️
APP_KEY=
APP_DEBUG=true
APP_ENV=local

# Authentication is now set in options

# Database (auto-configured by default to use SQLite)
DB_CONNECTION=sqlite

# Session & Cache (file-based by default, no config needed)
SESSION_DRIVER=file
CACHE_STORE=file

# debug locally, error or warning in production; rotation keeps LOG_DAILY_DAYS files
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14
